<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=verilog --write_settings_files=off mux81a2223 -c mux81a2223 --vector_source="D:/FPGA_Lab/exp1/optional_81mux_verilog/mux81a2223.vwf" --testbench_file="D:/FPGA_Lab/exp1/optional_81mux_verilog/simulation/qsim/mux81a2223.vwf.vt"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=verilog --output_directory="D:/FPGA_Lab/exp1/optional_81mux_verilog/simulation/qsim/" mux81a2223 -c mux81a2223</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="D:/FPGA_Lab/exp1/optional_81mux_verilog/simulation/qsim/" mux81a2223 -c mux81a2223</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vlog -work work mux81a2223.vo
vlog -work work mux81a2223.vwf.vt
vsim -novopt -c -t 1ps -L cycloneive_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.mux81a2223_vlg_vec_tst
vcd file -direction mux81a2223.msim.vcd
vcd add -internal mux81a2223_vlg_vec_tst/*
vcd add -internal mux81a2223_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vlog -work work mux81a2223.vo
vlog -work work mux81a2223.vwf.vt
vsim -novopt -c -t 1ps -L cycloneive_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.mux81a2223_vlg_vec_tst
vcd file -direction mux81a2223.msim.vcd
vcd add -internal mux81a2223_vlg_vec_tst/*
vcd add -internal mux81a2223_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script_timing>
<hdl_lang>verilog</hdl_lang>
</simulation_settings>*/
