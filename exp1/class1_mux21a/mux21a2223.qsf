set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE55F23C8
set_global_assignment -name TOP_LEVEL_ENTITY mux21a2223
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_FILE mux21a2223.vhd

# KX-CDS 实验台 电路模式 No.5 引脚锁定
# a -> CLKB0 (1024Hz)  W22
# b -> CLKB1 (256Hz)   W21
# s -> 按键1  PIO0     N1
# y -> 蜂鸣器 DBT1     AA8
set_location_assignment PIN_W22 -to a
set_location_assignment PIN_W21 -to b
set_location_assignment PIN_N1 -to s
set_location_assignment PIN_AA8 -to y

set_global_assignment -name PROJECT_CREATION_TIME_DATE "10:30:00 2026/09/09"

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name VECTOR_WAVEFORM_FILE mux21a2223.vwf
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top